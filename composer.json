{
    "name": "project-ace/robot-scheduler",
    "description": "Robot Fleet Scheduler - PHP + PostgreSQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-pdo_pgsql": "Required to actually connect to PostgreSQL. Not a hard requirement so the unit suite installs on machines without it; Database.php checks for it at runtime."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "lint": "find src public scripts -name '*.php' -print0 | xargs -0 -n1 php -l",
        "seed": "php scripts/seed.php"
    },
    "config": {
        "sort-packages": true
    }
}
